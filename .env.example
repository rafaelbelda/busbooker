# busbooker configuration — copy to `.env` and edit.
#
#   cp .env.example .env
#
# Every value below is a default from core/config.py except ADMIN_PASSWORD, which
# is REQUIRED and has no default: the app refuses to start without it.

# ── admin ────────────────────────────────────────────────────────
# HTTP Basic password for /admin/* (username is fixed: "admin").
# REQUIRED — startup fails with a clear error if unset.
ADMIN_PASSWORD=

# ── browser / site ───────────────────────────────────────────────
BASE_URL=https://mobifacil.com.br
USER_DATA_DIR=./browser_profile
# false = headed Chromium (needs a display; start.sh wraps it in xvfb-run on
# Linux). true = headless, no display needed.
HEADLESS=false

# ── flow tuning ──────────────────────────────────────────────────
# Attempts (not *re*-tries) for retry-wrapped browser steps. 1 disables retrying.
MAX_RETRIES=2
# Hard wall-clock budget for one browser flow. On expiry the flow is abandoned
# and reported as exit 2, so a hung Chromium cannot wedge every reservation.
FLOW_TIMEOUT_SECONDS=240

# ── scheduler ────────────────────────────────────────────────────
# Minutes between a reservation's re-lock attempts. Must stay comfortably BELOW
# the provider's seat-hold TTL or the seat is publicly bookable between cycles.
SCHEDULER_INTERVAL=14
# Stop re-locking this many minutes before departure — the provider delists a
# trip shortly before it leaves, so a later re-lock cannot succeed.
RELOCK_STOP_MINUTES_BEFORE_DEPARTURE=15

# ── persistence ──────────────────────────────────────────────────
# SQLite file holding reservations across restarts. ":memory:" disables durability.
RESERVATION_DB=core/data/reservations.db
# Delete reservations and their logs this many days after departure. 0 = never.
RETENTION_DAYS=7

# ── abuse protection ─────────────────────────────────────────────
# Per-client-IP requests/minute on /seats, /search and /reservations. 0 = off
# (fine for a tailnet-only deployment; turn it on before exposing publicly).
RATE_LIMIT_PER_MIN=0
# Max concurrent queued+running browser requests before new ones get a fast 503.
MAX_FLOW_QUEUE=8
# Comma-separated proxy IPs/CIDRs whose X-Real-IP / X-Forwarded-For we trust.
# Loopback is always trusted, so the default nginx-on-localhost setup needs nothing.
TRUSTED_PROXIES=

# ── logging ──────────────────────────────────────────────────────
LOG_FILE=core/logs/app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
RESERVATION_LOG_DIR=core/logs/reservations
