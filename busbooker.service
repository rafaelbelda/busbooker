[Unit]
Description=busbooker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/busbooker

# Use the venv that has the pinned requirements + `playwright install chromium`.

Environment=PATH=/home/busbooker/venv/bin:/usr/bin:/bin

# Override defaults from config.py here, or ship a .env in WorkingDirectory.
# Environment=HEADLESS=false

ExecStart=/usr/bin/env bash /home/busbooker/core/start.sh
Restart=on-failure
RestartSec=5
# start.sh already wraps uvicorn in xvfb-run when DISPLAY is absent.

[Install]
WantedBy=multi-user.target
