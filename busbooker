# ─────────────────────────────────────────────────────────────────
# busbooker — nginx reverse proxy → uvicorn (127.0.0.1:8771)
#
# Install:
#   cp busbooker /etc/nginx/sites-available/busbooker
#   ln -s /etc/nginx/sites-available/busbooker /etc/nginx/sites-enabled/busbooker
#   nginx -t && systemctl reload nginx
# ─────────────────────────────────────────────────────────────────

upstream busbooker {
    server 127.0.0.1:8771;
    keepalive 16;
}

server {
    listen 80;
    server_name busbooker.anarquia.me;

    proxy_read_timeout    120s;
    proxy_connect_timeout 10s;
    proxy_send_timeout    120s;

    proxy_http_version 1.1;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /health {
        access_log off;
        proxy_pass http://busbooker;
    }

    location / {
        proxy_pass http://busbooker;
    }
}
